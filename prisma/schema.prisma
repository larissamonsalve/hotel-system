generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CargoFuncionario {
  ADMIN
  RECEPCIONISTA
}

enum StatusQuarto {
  DISPONIVEL
  RESERVADO
  OCUPADO
  MANUTENCAO
}

enum StatusReserva {
  PENDENTE
  TAXA_RESERVA
  CONFIRMADA_BALCAO
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum OrigemReserva {
  ONLINE
  BALCAO
}

enum TipoPagamento {
  SINAL_30
  SALDO_70
  INTEGRAL
  CONSUMO_EXTRA
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

model Hotel {
  id           String        @id @default(uuid())
  slug         String        @unique
  nome         String
  cnpj         String        @unique
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  funcionarios Funcionario[]
  leads        Lead[]
  quartos      Quarto[]
  reservas     Reserva[]
  pagamentos   Pagamento[]
  consumos     Consumo[]
}

model Funcionario {
  id                  String      @id @default(uuid())
  hotelId             String
  hotel               Hotel       @relation(fields: [hotelId], references: [id])
  nome                String
  email               String
  senhaHash           String
  cargo               CargoFuncionario @default(RECEPCIONISTA)
  ativo               Boolean     @default(true)
  criadoEm            DateTime    @default(now())
  reservasGerenciadas Reserva[]
  pagamentosRecebidos Pagamento[]
  consumosRegistrados Consumo[]

  @@unique([hotelId, email])
}

model Lead {
  id            String    @id @default(uuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  nome          String
  email         String
  whatsapp      String
  emailValidado Boolean   @default(false)
  criadoEm      DateTime  @default(now())
  reservas      Reserva[]

  @@unique([hotelId, email])
}

model Otp {
  id         String   @id @default(uuid())
  email      String   @unique
  codigoHash String
  expiraEm   DateTime
  tentativas Int      @default(0)
  utilizado  Boolean  @default(false)
  criadoEm   DateTime @default(now())
}

model Quarto {
  id          String       @id @default(uuid())
  hotelId     String
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  numero      String
  tipo        String
  capacidade  Int
  valorDiaria Decimal      @db.Decimal(10, 2)
  status      StatusQuarto @default(DISPONIVEL)
  reservas    Reserva[]

  @@unique([hotelId, numero])
}

model Reserva {
  id               String        @id @default(uuid())
  hotelId          String
  hotel            Hotel         @relation(fields: [hotelId], references: [id])
  origem           OrigemReserva
  status           StatusReserva @default(PENDENTE)
  leadId           String
  lead             Lead          @relation(fields: [leadId], references: [id])
  quartoId         String
  quarto           Quarto        @relation(fields: [quartoId], references: [id])
  funcionarioId    String?
  funcionario      Funcionario?  @relation(fields: [funcionarioId], references: [id])
  checkInPrevisto  DateTime
  checkOutPrevisto DateTime
  checkInReal      DateTime?
  checkOutReal     DateTime?
  valorTotal       Decimal       @db.Decimal(10, 2)
  valorPago        Decimal       @default(0.00) @db.Decimal(10, 2)
  criadoEm         DateTime      @default(now())
  atualizadoEm     DateTime      @updatedAt
  pagamentos       Pagamento[]
  consumos         Consumo[]
}

model Pagamento {
  id            String          @id @default(uuid())
  hotelId       String
  hotel         Hotel           @relation(fields: [hotelId], references: [id])
  reservaId     String
  reserva       Reserva         @relation(fields: [reservaId], references: [id])
  funcionarioId String?
  funcionario   Funcionario?    @relation(fields: [funcionarioId], references: [id])
  valor         Decimal         @db.Decimal(10, 2)
  tipo          TipoPagamento
  metodo        MetodoPagamento
  referenciaExt String?
  criadoEm      DateTime        @default(now())
}

model Consumo {
  id            String      @id @default(uuid())
  hotelId       String
  hotel         Hotel       @relation(fields: [hotelId], references: [id])
  reservaId     String
  reserva       Reserva     @relation(fields: [reservaId], references: [id])
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  descricao     String
  quantidade    Int         @default(1)
  valorUnitario Decimal     @db.Decimal(10, 2)
  valorTotal    Decimal     @db.Decimal(10, 2)
  criadoEm      DateTime    @default(now())
}