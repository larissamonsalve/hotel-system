generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS (Domínio de Status) ---------------- //
enum CargoFuncionario {
  ADMIN
  RECEPCIONISTA
}

enum StatusQuarto {
  DISPONIVEL
  RESERVADO
  OCUPADO
  MANUTENCAO
}

enum StatusReserva {
  PENDENTE          // Criada na Landing Page, aguardando pagamento
  TAXA_RESERVA      // 30% pago via webhook (Mercado Pago), aguardando check-in
  CONFIRMADA_BALCAO // Criada direto no balcão
  EM_ANDAMENTO      // Check-in realizado (Hóspede no hotel)
  FINALIZADA        // Check-out realizado (Conta quitada)
  CANCELADA         // Cancelada pelo cliente ou painel
}

enum OrigemReserva {
  ONLINE            // Landing Page
  BALCAO            // Recepção
}

enum TipoPagamento {
  SINAL_30
  SALDO_70
  INTEGRAL
  CONSUMO_EXTRA
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

// ---------------- MODELOS ---------------- //

model Funcionario {
  id         String           @id @default(uuid())
  nome       String
  email      String           @unique
  senhaHash  String
  cargo      CargoFuncionario @default(RECEPCIONISTA)
  ativo      Boolean          @default(true)
  criadoEm   DateTime         @default(now())

  // Rastreabilidade de ações no painel
  reservasGerenciadas Reserva[]
  pagamentosRecebidos Pagamento[]
  consumosRegistrados Consumo[]
}

model Lead {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  whatsapp      String
  emailValidado Boolean   @default(false)
  criadoEm      DateTime  @default(now())
  
  reservas      Reserva[]
}

model Otp {
  id         String   @id @default(uuid())
  email      String   @unique
  codigoHash String
  expiraEm   DateTime
  tentativas Int      @default(0)
  utilizado  Boolean  @default(false)
  criadoEm   DateTime @default(now())
}

model Quarto {
  id          String       @id @default(uuid())
  numero      String       @unique
  tipo        String       // Ex: "Casal Standard", "Suíte Master"
  capacidade  Int
  valorDiaria Decimal      @db.Decimal(10, 2)
  status      StatusQuarto @default(DISPONIVEL)
  
  reservas    Reserva[]
}

model Reserva {
  id                 String        @id @default(uuid())
  origem             OrigemReserva
  status             StatusReserva @default(PENDENTE)

  // Relacionamentos
  leadId             String
  lead               Lead          @relation(fields: [leadId], references: [id])
  quartoId           String
  quarto             Quarto        @relation(fields: [quartoId], references: [id])
  
  // Auditoria: Qual funcionário registrou o check-in/out ou criou a reserva balcão
  funcionarioId      String?
  funcionario        Funcionario?  @relation(fields: [funcionarioId], references: [id])

  // Datas de Controle
  checkInPrevisto    DateTime
  checkOutPrevisto   DateTime
  checkInReal        DateTime?
  checkOutReal       DateTime?

  // Financeiro da Reserva
  valorTotal         Decimal       @db.Decimal(10, 2)
  valorPago          Decimal       @default(0.00) @db.Decimal(10, 2)

  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt

  pagamentos         Pagamento[]
  consumos           Consumo[]
}

model Pagamento {
  id             String          @id @default(uuid())
  reservaId      String
  reserva        Reserva         @relation(fields: [reservaId], references: [id])
  
  // Quem recebeu (Nulo se foi online via Mercado Pago)
  funcionarioId  String?
  funcionario    Funcionario?    @relation(fields: [funcionarioId], references: [id])

  valor          Decimal         @db.Decimal(10, 2)
  tipo           TipoPagamento
  metodo         MetodoPagamento
  referenciaExt  String?         // ID do Mercado Pago (para estornos/auditoria)
  
  criadoEm       DateTime        @default(now())
}

model Consumo {
  id             String       @id @default(uuid())
  reservaId      String
  reserva        Reserva      @relation(fields: [reservaId], references: [id])
  
  funcionarioId  String
  funcionario    Funcionario  @relation(fields: [funcionarioId], references: [id])

  descricao      String       // Ex: "Água sem gás", "Lavanderia"
  quantidade     Int          @default(1)
  valorUnitario  Decimal      @db.Decimal(10, 2)
  valorTotal     Decimal      @db.Decimal(10, 2)
  
  criadoEm       DateTime     @default(now())
}